{
  "name": "mg",
  "version": "1.0.0",
  "description": "MG - Todo & Free Note workspace for Windows",
  "main": "electron/main.js",
  "author": "MG",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run icon && npm run build && electron-builder --win",
    "dist:portable": "npm run icon && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.mg.workspace",
    "productName": "MG",
    "copyright": "Copyright © 2026 MG",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MG",
      "artifactName": "MG-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MG-${version}-portable.${ext}"
    }
  }
}
